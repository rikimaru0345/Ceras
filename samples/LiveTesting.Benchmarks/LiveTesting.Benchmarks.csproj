<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Roadmap performance workloads (TODO P0 0.7).

    These benchmark models need a generated Ceras context, but they do not need the Ceras.Test
    assembly. Keeping them in their own compilation that references only Ceras + the source
    generator gives them a real generated manifest ("Tests") without colliding with Ceras.Test's
    generated Ceras.Generated.CerasConfigExtensions / RobustFormatters (two generator-enabled
    assemblies referenced from one compilation would produce ambiguous extension methods).

    LiveTesting references this project and calls RoadmapBenchmarks.RunQuick / the BenchmarkDotNet
    entry points; see samples/LiveTesting/Program.cs.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>disable</Nullable>
    <RootNamespace>LiveTesting.Benchmarks</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Ceras\Ceras.csproj" />
    <ProjectReference Include="..\..\src\Ceras.SourceGenerator\Ceras.SourceGenerator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
    <PackageReference Include="BenchmarkDotNet" Version="0.13.12" />
  </ItemGroup>

</Project>
