<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EmitCompilerGeneratedFiles>false</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>Generated</CompilerGeneratedFilesOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Ceras.ImmutableCollections\Ceras.ImmutableCollections.csproj" />
    <ProjectReference Include="..\..\src\Ceras\Ceras.csproj" />
    <!-- Wire up the source generator so it runs when building tests -->
    <ProjectReference Include="..\..\src\Ceras.SourceGenerator\Ceras.SourceGenerator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="true" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" />
    <PackageReference Include="MSTest.TestAdapter" Version="3.1.1" />
    <PackageReference Include="MSTest.TestFramework" Version="3.1.1" />
    <PackageReference Include="xunit" Version="2.7.0" />
    <PackageReference Include="xunit.extensibility.execution" Version="2.7.0" />
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.6">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!--
    The checked-in golden fixtures for the cross-version tests. They are bytes written by
    fixtures/Ceras.HistoricalWriter, which is deliberately NOT referenced from here: the v1 CLR types
    must be absent from the reader build. Copied to the output so the tests read the real files.
  -->
  <ItemGroup>
    <None Include="Fixtures\**\*.bin" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    The fake duplex transport and the loop measurement helper, compiled in from shared/ rather than
    copied. samples/Ceras.Benchmarks compiles the same two files, so the smoke test and the
    benchmark move bytes the same way and time them the same way; see shared/GameplayLoop/README.md
    for why this is a source link and not a project reference (a reference from the benchmark to the
    test suite would undo the benchmark's stated independence from it).
  -->
  <ItemGroup>
    <Compile Include="..\..\shared\GameplayLoop\FakeDuplexTransport.cs" Link="GameplayLoop\FakeDuplexTransport.cs" />
    <Compile Include="..\..\shared\GameplayLoop\LoopMeasurement.cs" Link="GameplayLoop\LoopMeasurement.cs" />
  </ItemGroup>

  <!--
    Probes/*.cs is *not* part of this compilation. It is the source of a small console
    program that BanVerdictCacheColdPathTests compiles at test time and runs as a fresh child process,
    because the ban verdict cache is only empty at the start of a process and the shared xUnit
    process cannot observe "the first lookup". It is a .cs file so it stays readable and navigable,
    but it must be excluded from the build here - a Main and a Program class in a test assembly would
    be ambiguous, and the probe deliberately has no xunit dependency. BanVerdictCacheColdPathTests
    asserts that it still compiles, so a stale probe fails the suite instead of passing quietly.
  -->
  <ItemGroup>
    <Compile Remove="Probes\**" />
    <None Include="Probes\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
