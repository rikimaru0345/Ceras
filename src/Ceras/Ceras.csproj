<Project Sdk="Microsoft.NET.Sdk">

  <!-- NuGet Package -->
  <PropertyGroup>
    <Version>4.1.7</Version>
    <Authors>rikimaru0345</Authors>
    <Copyright>https://github.com/rikimaru0345/Ceras/blob/master/LICENSE</Copyright>
    <PackageProjectUrl>https://github.com/rikimaru0345/Ceras</PackageProjectUrl>
    <RepositoryUrl>https://github.com/rikimaru0345/Ceras</RepositoryUrl>
    <releaseNotes>https://github.com/rikimaru0345/Ceras/releases</releaseNotes>
    <!-- Package claims are kept in sync with README.md; each one is checkable against src/ or
         tests/Ceras.Test. Not claimed, and not to be re-added without a test: allocation-free
         serialization (it allocates), delegate support (banned in Helpers/BannedTypes.cs), a
         KnownTypes option (removed), and Unity/IL2CPP/AOT platform support (src/Ceras.UnityAddon
         is an empty shell and nothing AOT is tested). -->
    <Description>
      Extremely fast binary serializer.
      Reference persistence including circular references, polymorphism, and a separate robust,
      self-describing format for persistent saves: layout fingerprint, a fast generated reader path,
      and a migration path for older schemas. User-type formatters are emitted at compile time by a
      Roslyn source generator, so nothing is compiled or emitted at runtime. The robust format only
      accepts types declared in a named serialization context; delegates, reflection metadata,
      enumerators and engine-native objects are excluded from the payload. Serialization is not
      allocation-free, and Unity/IL2CPP and NativeAOT are not verified. Checkout the github page for
      a full feature list!
    </Description>
    <PackageTags>utility, ceras, serialization, binary, serializer, formatter, network, networking, immutable, sourcegenerator</PackageTags>
  </PropertyGroup>

  <!-- C# Compiler Settings -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DocumentationFile>bin\$(Configuration)\$(TargetFramework)\$(AssemblyName).xml</DocumentationFile>
    <!-- Missing XML comment for type... -->
    <NoWarn>1591;</NoWarn>
    <!--
      Nullable reference analysis, project-wide. The library hands out null in plenty of
      places on purpose - a formatter for an unknown member, the "no plan" case, an unresolvable type - so the
      annotations are the only thing that records which of those are contracts and which are accidents. It is on
      for the whole project rather than per file so a new file cannot silently opt out, and the warnings are
      meant to be fixed rather than suppressed.
      Status: not yet a build gate. Neither `WarningsAsErrors` nor `TreatWarningsAsErrors` is set
      anywhere in this repository, so a new warning does not fail the build; this project still
      emits a substantial number of CS8601/CS8603/CS8604/CS8600/CS8618 sites. Clearing them is
      tracked by TODO.md (Priority 0 -> Warnings), not by this file.
    -->
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Debug'">
    <DefineConstants>TRACE;DEBUG</DefineConstants>
  </PropertyGroup>

  <!--
    The robust header's CRC32 is computed over the whole save on every Save and re-verified before
    anything it protects is read on every Load, so this is the library's only per-byte hashing work on
    a hot path. System.IO.Hashing's Crc32 is the *same* CRC-32/ISO-HDLC polynomial (0xEDB88320, zlib,
    PKZIP) as the table it replaces, so the stored checksum bytes and therefore every checked-in
    fixture are unchanged; it is simply computed with carry-less multiply folding instead of one table
    lookup per byte. See Helpers/HashHelpers.cs for which instruction is used where, and why the x86
    SSE4.2 crc32 instruction is not. No transitive dependencies for net10.0.
  -->
  <ItemGroup>
    <PackageReference Include="System.IO.Hashing" Version="10.0.12" />
  </ItemGroup>

</Project>
