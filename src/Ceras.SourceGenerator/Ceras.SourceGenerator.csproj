<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Source generators MUST target netstandard2.0 -->
    <TargetFramework>netstandard2.0</TargetFramework>
    <!-- Don't ship the generator DLL as a regular reference assembly -->
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <!-- Enforce rules that keep the generator host-agnostic -->
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IsRoslynComponent>true</IsRoslynComponent>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <!-- Pinned, not `latest`: the analyzer must never be able to start using a newer C# than the
         consumers it generates code for. netstandard2.0 would otherwise default to C# 7.3, and
         `latest` would silently follow a future SDK past the platform's C# 14 that the root
         Directory.Build.props pins. The emitted C# needs C# 8.0 at most, so pinning the generator
         here keeps a wide margin for consumers. -->
    <LangVersion>14.0</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- Must match the Roslyn shipped with the pinned .NET 10 SDK (C# 14). -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" PrivateAssets="all" />
  </ItemGroup>

</Project>
